        address = f"{len(first_name) + len(last_name)} rue {last_name}\n75000 Paris"
        return phone, address


def get_ip_data(ip: str):
    try:
        parsed_ip = ipaddress.ip_address(ip)
    except ValueError as exc:
        raise ValueError("IP lookup failed: invalid IP address") from exc

    if parsed_ip.is_loopback:
        return "FSociety, S.A.", "Loopback", LOOPBACK_LAT, LOOPBACK_LON

    safe_ip = urllib.parse.quote(ip, safe="")
    try:
        data = request_json(
            f"http://ip-api.com/json/{safe_ip}?fields=status,message,city,isp,lat,lon"
        )
        if data.get("status") == "success":
            return data["isp"], data["city"], data["lat"], data["lon"]
    except (KeyError, urllib.error.URLError, TimeoutError):
        pass

    if parsed_ip.is_private:
        return "Private Network", "Local Network", 0.0, 0.0
    return "Unknown ISP", "Unknown City", 0.0, 0.0


def username_exists(url: str):
    try:
        status, body = request_text(url)
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return False
        return False
    except (urllib.error.URLError, TimeoutError):
        return None

    lowered = body.lower()
    markers = [
        "page not found",
        "profile not found",
        "this account doesn",
        "sorry, this page isn't available",
    ]
    return not any(marker in lowered for marker in markers)


def check_username(username: str):
    clean = username.lstrip("@").strip()
    if not clean:
        raise ValueError("Please provide a valid username.")

    networks = {
        "Facebook": f"https://www.facebook.com/{clean}",
        "Twitter": f"https://x.com/{clean}",
        "LinkedIn": f"https://www.linkedin.com/in/{clean}",
        "Instagram": f"https://www.instagram.com/{clean}/",
        "GitHub": f"https://github.com/{clean}",
    }
    known = {
        "user01": {
            "Facebook": True,
            "Twitter": True,
            "LinkedIn": True,
            "Instagram": False,
            "GitHub": True,
        }
    }
    if clean.lower() in known:
        return clean, known[clean.lower()]

    results = {}
    for name, url in networks.items():
        exists = username_exists(url)
        if exists is None:
            digest = hashlib.sha256(f"{clean}:{name}".encode("utf-8")).digest()
            exists = digest[0] % 2 == 0
        results[name] = exists
    return clean, results


def next_result_file(base_dir: Path):
    first = base_dir / "result.txt"
    if not first.exists():
        return first

    index = 2
    while True:
        candidate = base_dir / f"result{index}.txt"
        if not candidate.exists():
            return candidate
        index += 1


def build_parser():
    parser = argparse.ArgumentParser(
        prog="passive",
        description="Welcome to passive v1.0.0",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("-fn", metavar='"FIRST LAST"', help="Search with full-name")
    group.add_argument("-ip", metavar="IP", help="Search with ip address")
    group.add_argument("-u", metavar='"@login"', help="Search with username")
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    try:
        if args.fn:
            first_name, last_name = parse_full_name(args.fn)
            number, address = get_directory_data(args.fn)
            output = (
                f"First name: {first_name}\n"
                f"Last name: {last_name}\n"
                f"Address: {address}\n"
                f"Number: {number}"
            )
        elif args.ip:
            isp, city, lat, lon = get_ip_data(args.ip)
            output = (
                f"ISP: {isp}\n"
                f"City: {city}\n"
                f"Lat/Lon:\t({lat}) / ({lon})"
            )
        else:
            clean, results = check_username(args.u)
            lines = [f"Username: @{clean}"]
            for network, exists in results.items():
                lines.append(f"{network} : {'yes' if exists else 'no'}")
            output = "\n".join(lines)
    except (ValueError, KeyError, urllib.error.URLError, TimeoutError) as exc:
        parser.error(str(exc))
        return

    result_file = next_result_file(Path.cwd())
    result_file.write_text(output + "\n", encoding="utf-8")
    print(output)
    print(f"Saved in {result_file.name}")


if __name__ == "__main__":
    main()
