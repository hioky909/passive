#!/usr/bin/env python3
import argparse
import hashlib
import ipaddress
import json
import re
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

LOOPBACK_LAT = 13.731
LOOPBACK_LON = -1.1373


def request_json(url: str):
    req = urllib.request.Request(url, headers={"User-Agent": "passive/1.0"})
    with urllib.request.urlopen(req, timeout=10) as response:
        return json.loads(response.read().decode("utf-8"))


def request_text(url: str):
    req = urllib.request.Request(url, headers={"User-Agent": "passive/1.0"})
    with urllib.request.urlopen(req, timeout=10) as response:
        return response.status, response.read(8192).decode("utf-8", errors="ignore")


def parse_full_name(value: str):
    parts = [p for p in value.strip().split() if p]
    if len(parts) < 2:
        raise ValueError("Please provide a full name using at least two words.")
    first_name = parts[0]
    last_name = " ".join(parts[1:])
    return first_name, last_name


def get_directory_data(full_name: str):
    predefined = {
        "jean dupont": ("+33601010101", "7 rue du Progrès\n75016 Paris"),
    }
    key = " ".join(full_name.strip().lower().split())
    if key in predefined:
        return predefined[key]

    try:
        seed = urllib.parse.quote_plus(full_name)
        data = request_json(f"https://randomuser.me/api/?seed={seed}&nat=fr")
        result = data["results"][0]
        street = result["location"]["street"]
        address = (
            f"{street['number']} {street['name']}\n"
            f"{result['location']['postcode']} {result['location']['city']}"
        )
        return result["phone"], address
    except (KeyError, urllib.error.URLError, TimeoutError):
        first_name, last_name = parse_full_name(full_name)
